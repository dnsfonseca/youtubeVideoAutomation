# Copiar este arquivo para ".env" na raiz do projeto e preencher.
# Nunca commitar o ".env" real nem colar valores dele no chat.

# --- Obrigatorias ---

# Chave da API do Claude (Anthropic). Usada na Etapa 3 (geracao de
# roteiro). A Etapa 5 (geracao de clipes) nao chama API nenhuma - selecao
# aleatoria de trechos, so' ffmpeg local.
ANTHROPIC_API_KEY=

# Diretorio raiz onde cada projeto de video ganha sua propria subpasta.
# Exemplo: E:\broll
PROJETOS_DIR=

# --- Opcionais ---

# Modelo do Claude usado na Etapa 3 (opcional, default claude-sonnet-5).
# Alternativas: claude-haiku-4-5 (mais barato), claude-opus-4-8 (melhor)
ANTHROPIC_MODEL=claude-sonnet-5

# Idioma alvo do roteiro e dos titulos gerados. Default: en-US
# Opcoes: en-US, en-GB, pt-BR, es, de
IDIOMA_ROTEIRO=en-US

# Chave da YouTube Data API v3 (opcional). Se ausente, a busca de
# titulos de referencia no YouTube desliga sozinha na Etapa 3.
YOUTUBE_API_KEY=

# Porta onde o servidor Flask local escuta. Default: 5000
PORTA=5000

# Modelo do faster-whisper usado na Etapa 2. Default: medium
# Opcoes: small, medium, large-v3
WHISPER_MODEL=medium

# Dispositivo do faster-whisper. Default: cuda (cai para cpu se CUDA
# nao for encontrado).
WHISPER_DEVICE=cuda

# Aplica o efeito Ken Burns (zoom lento, distribuido ao longo de toda a
# duracao do clipe) nos clipes gerados na Etapa 5. Default: true.
KEN_BURNS=true

# Duracao alvo de cada clipe gerado na Etapa 5, em segundos - sorteada
# uniformemente entre estes limites para cada trecho da narracao.
# Default: 6 a 10.
CLIPE_DURACAO_MIN_S=6
CLIPE_DURACAO_MAX_S=10

# Margens de seguranca no inicio/fim de cada video-fonte, em segundos -
# evita que a selecao aleatoria caia numa intro/outro/patrocinio do
# video-fonte. Default: 30 nos dois casos.
MARGEM_INICIO_S=30
MARGEM_FIM_S=30

# --- TTS (narracao) - todas as variaveis abaixo sao opcionais ---
# Nenhuma chave de TTS e obrigatoria: se voce so pretende usar audio
# proprio (upload de voz gravada) nos projetos, pode deixar tudo em
# branco. Preencha so os provedores que pretende usar - a escolha de
# qual provedor gerar o audio de cada video e feita por projeto, na
# tela de revisao do roteiro (CLAUDE.md secao 5.6).

# Provedor de TTS pre-selecionado na tela de revisao. Default: vazio
# (nenhum pre-selecionado, usuario escolhe a cada projeto).
# Opcoes: google, elevenlabs, openai, azure
TTS_PROVEDOR_PADRAO=

# Voz pre-selecionada na tela de revisao (nome/id da voz, depende do
# provedor escolhido). Default: vazio.
TTS_VOZ_PADRAO=

# Chave da API Google Cloud Text-to-Speech. Provedor PRINCIPAL de TTS
# (CLAUDE.md secao 5.6) - o unico implementado de verdade no MVP.
# Apenas vozes do tier Wavenet sao usadas ($4 por 1 milhao de caracteres) -
# protecao de custo, nao alterar sem validacao. Crie a chave em
# console.cloud.google.com (API "Cloud Text-to-Speech") - ver LEIAME.md.
GOOGLE_TTS_API_KEY=

# Chave da API DarkPlanner (app.darkplanner.com.br) - vozes ElevenLabs via
# plano PRO/Plus ja pago pelo usuario. Provedor implementado (CLAUDE.md
# secao 5.6). API assincrona (job com polling) encapsulada em
# scripts/tts/darkplanner.py.
DARKPLANNER_API_KEY=

# Chave da API ElevenLabs (uso direto, sem o DarkPlanner acima). Provedor
# ainda NAO implementado nesta versao
# (stub - ver CLAUDE.md secao 5.6). Reservado para uma sessao futura.
ELEVENLABS_API_KEY=

# Chave da API OpenAI - mesma conta/chave usada em dois lugares:
# 1) TTS da OpenAI (CLAUDE.md secao 5.6) - provedor ainda NAO
#    implementado nesta versao (stub).
# 2) Composicao da thumbnail por IA (Etapa 7, CLAUDE.md secao 5.85) - esse
#    SIM implementado de verdade, e e' hoje o UNICO caminho real de gerar
#    a imagem da thumbnail (scripts/imagem/openai.gerar_composicao).
#    Obrigatoria pra marcar "Gerar thumbnail" no formulario de Novo
#    projeto. Configurar esta chave so' pra thumbnail NAO habilita o TTS
#    OpenAI (continua indisponivel na tela de revisao, mensagem clara).
OPENAI_API_KEY=

# Chave da API Azure TTS. Provedor ainda NAO implementado nesta versao
# (stub - ver CLAUDE.md secao 5.6).
AZURE_TTS_KEY=

# Regiao do recurso Azure TTS (ex: eastus). So necessaria junto com
# AZURE_TTS_KEY.
AZURE_TTS_REGION=

# --- Legendas queimadas (Etapa 6, estilo "MrBeast") ---
# Cor primaria (branco), contorno (preto) e espessura do contorno NAO sao
# configuraveis - sao fixos no codigo (scripts/6_montar_video.py) porque
# garantem legibilidade da legenda sobre qualquer fundo de video.

# Fonte usada na legenda queimada. Default: Poppins Bold
# Opcoes: Poppins Bold, Arial Black, Impact
LEGENDA_FONTE=Poppins Bold

# Tamanho da fonte em pontos, referencia para video 1080p. Default: 64
# Opcoes: 56 (pequeno), 64 (padrao), 72 (grande)
LEGENDA_TAMANHO=64

# Posicao vertical da legenda. Default: baixo
# Opcoes: baixo, meio-baixo
LEGENDA_POSICAO=baixo

# Destaca a palavra sendo dita em cor diferente (estilo karaoke,
# padrao do nicho faceless true crime para retencao). Default: true
LEGENDA_KARAOKE_ATIVO=true

# Cor de destaque da palavra ativa (so' tem efeito se LEGENDA_KARAOKE_ATIVO
# estiver ligado). Default: amarelo
# Opcoes: amarelo, verde, laranja, rosa
LEGENDA_DESTAQUE_COR_NOME=amarelo

# Volume base da musica de fundo (Etapa 6), quando ativada em um projeto -
# reduzido automaticamente quando ha narracao (ducking). Default: 0.18
# (bem baixo, so' ambiente). Clamp entre 0.05 (quase mudo) e 0.50 (alto,
# compete com a voz).
MUSICA_VOLUME_BASE=0.18

# Maximo de buscas web por roteiro. Padrao 5 (Sessao 22) - buscas frescas
# ajudam o roteiro a refletir desenvolvimentos recentes de um caso em vez
# de so' o que os videos-fonte (potencialmente antigos) diziam. Reduza pra
# economizar em temas evergreen (ex: historia antiga, onde frescor de
# dados importa pouco); cada busca extra custa ~$0.02-0.03.
WEB_SEARCH_MAX=5

# Modo dry-run da Etapa 3 (geracao de roteiro) - para calibrar prompts
# sem gastar API real. Se "true", monta o prompt normalmente mas NAO
# chama a Anthropic API - grava o prompt final em dry_run_output.md na
# pasta do projeto. Default: false (chama a API de verdade).
DRY_RUN_API=false

# Validacao pos-geracao (Grupo C, sessao de refinamento pos-validacao
# empirica): sinaliza (nunca bloqueia, nunca corrige) numeros de
# duracao/janela temporal citados no roteiro sem nenhum marcador de
# derivacao (registros, horarios, sequencia de sinais) nas 2 frases
# anteriores - aviso exibido na tela de revisao. Desligue se a heuristica
# gerar ruido demais no uso real. Default: true.
VALIDACAO_NUMEROS_ATIVA=true

# Cotacao USD->BRL para exibir o custo estimado do roteiro (tela de
# revisao, CLAUDE.md secao 5.5/7) em reais alem de dolares. Aproximada -
# ajustar quando necessario. Se ausente/invalida, usa 5.20 e a tela
# mostra aviso de "cotacao estimada".
COTACAO_USD_BRL=5.20

# --- Thumbnail (Etapa 7) ---

# Gera thumbnail por padrao pra projetos novos (checkbox pre-marcado no
# formulario de Novo projeto, editavel por projeto ali mesmo - so' pode
# ser marcado com OPENAI_API_KEY configurada acima, ver secao 5.85 do
# CLAUDE.md). Default: true. Desligado, o projeto pula direto da montagem
# pra "concluido" sem passar pela tela de thumbnail.
GERAR_THUMBNAIL_PADRAO=true

# Lista de termos (separados por virgula) que eliminam um candidato de
# headline gerado pelo Headline Engine (scripts/headline_engine.py,
# Grupo B) antes mesmo de ir pro juiz. Configuravel de proposito - o
# YouTube nao publica lista estavel de termos que afetam monetizacao,
# entao esta lista e' so' uma protecao editorial (eliminar o candidato),
# NUNCA garantia de aprovacao/monetizacao. Vazia/ausente usa a lista
# padrao pequena embutida no codigo (TERMOS_RISCO_PADRAO).
# HEADLINE_TERMOS_RISCO=kill,killed,murder,rape,suicide

# --- Marca d'agua do canal (Etapa 6) ---

# Posicao da marca d'agua do canal (logo do usuario, aplicado por cima do
# video final - distinto da remocao de marca das FONTES na Etapa 5). O
# arquivo PNG em si e' enviado pela tela de Ajustes (nao por variavel de
# ambiente), salvo em config/marca_dagua_canal.png. Opcoes: superior_direito,
# superior_esquerdo, inferior_direito (default), inferior_esquerdo.
MARCA_DAGUA_CANAL_POSICAO=inferior_direito
